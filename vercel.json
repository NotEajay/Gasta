  "installCommand": "npm install --prefix mobile",
  "buildCommand": "npm run build:web --prefix mobile",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    { "source": "/((?!oauth-bridge\\.html).*)", "destination": "/index.html" }
  ]
}
