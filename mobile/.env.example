EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used by Expo Go Google sign-in (HTTPS callback). Must match Supabase Redirect URLs.
# Also used as the Expo Go map popup's web origin; allow it in the display key's website restrictions.
EXPO_PUBLIC_SITE_URL=https://gasta-kappa.vercel.app
# Public display key: enable Maps JavaScript API for web and the Expo Go station popup.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional production Google map ID; the station popup uses DEMO_MAP_ID during testing.
EXPO_PUBLIC_GOOGLE_MAP_ID=
